# VeraData LATAM Data Agent — environment variables
# Copy to .env and fill real values. Never commit a real key.

# Optional: override the API base (defaults to https://api.veradata.dev)
VERADATA_API_BASE=https://api.veradata.dev

# Tx hash after x402 payment (leave as TRIAL for the free tier).
VERADATA_TX_HASH=TRIAL
